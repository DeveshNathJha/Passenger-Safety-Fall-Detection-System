# Copy to .env and fill in. Never commit .env.

# Protect the API (REST: X-API-Key header, WebSocket: ?api_key=). Empty = open (LAN demo only).
FDS_API_KEY=

# Live SOS SMS via Twilio. If any of these are empty, alerts are logged (mock mode).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_CONTACT_NUMBER=

# Optional
FDS_LOG_LEVEL=INFO
# FDS_CONFIG=config/config.yaml
